<Project Sdk="Microsoft.NET.Sdk">

	<!-- 任意: 同じフォルダに AmongUsPath.props を置くと、そこで指定した <AmongUs> が使われる(AmongUsPath.props.example 参照) -->
	<Import Project="AmongUsPath.props" Condition="Exists('AmongUsPath.props')" />

	<PropertyGroup>

		<TargetFramework>net6.0</TargetFramework>

		<GenerateAssemblyFileVersionAttribute>false</GenerateAssemblyFileVersionAttribute>

		<GenerateAssemblyInformationalVersionAttribute>false</GenerateAssemblyInformationalVersionAttribute>

		<!-- gitリポジトリが無い/コミットが無い環境だとGitInfoが不正なバージョン文字列(例: 0.0.0+main.)を

		     生成し NETSDK1018 でビルドが失敗するため、明示的に固定バージョンを指定して上書きする -->

		<Version>1.0.0</Version>

		<AssemblyVersion>1.0.0.0</AssemblyVersion>

		<FileVersion>1.0.0.0</FileVersion>

		<InformationalVersion>1.0.0-local</InformationalVersion>

		<Description>fork by Town Of Host</Description>

		<Authors>tukasa0001(EmptyBottle), integral0131</Authors>

		<langVersion>preview</langVersion>

		<AssemblyName>TownOfHost-hamo</AssemblyName>

		<NoWarn>MSB3246;CS0162;CS0169;CS0184;CS0649;CS0414;GI001,IDE0017,IDE0090</NoWarn>

		<!-- Among Usのフォルダ。優先順位: ①ビルド時の -p:AmongUs="..." ②環境変数 AMONGUS_PATH ③AmongUsPath.props ④下の自動検出 -->
		<AmongUs Condition="'$(AmongUs)' == '' And '$(AMONGUS_PATH)' != ''">$(AMONGUS_PATH)</AmongUs>
		<AmongUs Condition="'$(AmongUs)' == '' And Exists('C:\Program Files (x86)\Steam\steamapps\common\Among Us\BepInEx\interop')">C:\Program Files (x86)\Steam\steamapps\common\Among Us</AmongUs>
		<AmongUs Condition="'$(AmongUs)' == '' And Exists('C:\Program Files\Steam\steamapps\common\Among Us\BepInEx\interop')">C:\Program Files\Steam\steamapps\common\Among Us</AmongUs>
		<AmongUs Condition="'$(AmongUs)' == '' And Exists('D:\SteamLibrary\steamapps\common\Among Us\BepInEx\interop')">D:\SteamLibrary\steamapps\common\Among Us</AmongUs>
		<AmongUs Condition="'$(AmongUs)' == '' And Exists('D:\Steam\steamapps\common\Among Us\BepInEx\interop')">D:\Steam\steamapps\common\Among Us</AmongUs>
		<AmongUs Condition="'$(AmongUs)' == '' And Exists('E:\SteamLibrary\steamapps\common\Among Us\BepInEx\interop')">E:\SteamLibrary\steamapps\common\Among Us</AmongUs>
		<AmongUs Condition="'$(AmongUs)' == '' And Exists('C:\Program Files\Epic Games\AmongUs\BepInEx\interop')">C:\Program Files\Epic Games\AmongUs</AmongUs>
		<AmongUs Condition="'$(AmongUs)' == '' And Exists('C:\Program Files (x86)\Epic Games\AmongUs\BepInEx\interop')">C:\Program Files (x86)\Epic Games\AmongUs</AmongUs>
		<!-- 見つからなかった場合は、下のCheckAmongUsPathが分かりやすいエラーを出す -->
		<AmongUs Condition="'$(AmongUs)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Among Us</AmongUs>

		<CopyToAmongUs Condition="'$(CopyToAmongUs)' == ''">true</CopyToAmongUs>

	</PropertyGroup>



	<ItemGroup>

		<Compile Remove="Roles\Madmate\MadSheriff_Sample.cs" />

	</ItemGroup>



	<ItemGroup>

		<Reference Include="$(AmongUs)\BepInEx\core\*.dll" />

		<Reference Include="$(AmongUs)\BepInEx\interop\*.dll" />

		<EmbeddedResource Include=".\Resources\**" />

		<!-- WatchdogLauncherが固定名で取り出すPowerShellを、ビルド環境差に左右されず必ず埋め込む。 -->

		<EmbeddedResource Update=".\Resources\TOHhamoWatchdog.ps1">

			<LogicalName>TownOfHost.Resources.TOHhamoWatchdog.ps1</LogicalName>

		</EmbeddedResource>

	</ItemGroup>



	<ItemGroup>

		<PackageReference Include="Costura.Fody" Version="6.2.0">

			<IncludeAssets>runtime; compile; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>

			<PrivateAssets>all</PrivateAssets>

		</PackageReference>

		<PackageReference Include="csv" Version="2.0.245" />

		<PackageReference Include="Newtonsoft.Json" Version="13.0.3" />

		<PackageReference Include="GitInfo" Version="3.6.0">

			<PrivateAssets>all</PrivateAssets>

			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>

		</PackageReference>

	</ItemGroup>



	<ItemGroup>

	  <Folder Include="ChatServer\" />

	</ItemGroup>



	<ItemGroup>

	  <Compile Update="Properties\Resources.Designer.cs">

	    <DesignTime>True</DesignTime>

	    <AutoGen>True</AutoGen>

	    <DependentUpon>Resources.resx</DependentUpon>

	  </Compile>

	</ItemGroup>



	<ItemGroup>

	  <EmbeddedResource Update="Properties\Resources.resx">

	    <Generator>ResXFileCodeGenerator</Generator>

	    <LastGenOutput>Resources.Designer.cs</LastGenOutput>

	  </EmbeddedResource>

	</ItemGroup>



	<Target Name="Copy" AfterTargets="Build" Condition="'$(CopyToAmongUs)' == 'true' And '$(AmongUs)' != ''">

		<Copy SourceFiles="$(OutputPath)$(AssemblyName).dll" DestinationFolder="$(AmongUs)/BepInEx/plugins/" />

	</Target>

	<!-- Among UsのBepInEx interopが見つからないとき、数千件の型エラーではなく原因を1件だけ表示して止める -->
	<Target Name="CheckAmongUsPath" BeforeTargets="ResolveAssemblyReferences;CoreCompile">
		<Error Condition="!Exists('$(AmongUs)\BepInEx\interop\Assembly-CSharp.dll')"
		       Text="Among Usの場所が正しくありません: '$(AmongUs)'。BepInEx\interop\Assembly-CSharp.dll が見つかりません。 対処: (1) AmongUsPath.props.example を AmongUsPath.props にコピーして自分のAmong Usフォルダに書き換える / または dotnet build -p:AmongUs=&quot;自分のパス&quot; を使う。 (2) そのフォルダにBepInEx(IL2CPP版)を入れて、Among Usを一度起動し BepInEx\interop を生成する。" />
	</Target>

</Project>
