*.csproj text eol=crlf
*.sln text eol=crlf
*.xml text eol=crlf
*.xsd text eol=crlf
*.resx text eol=crlf
*.json text eol=crlf
*.jsonc text eol=crlf
*.md text eol=crlf
*.txt text eol=crlf
*.yml text eol=crlf
*.yaml text eol=crlf
*.config text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
